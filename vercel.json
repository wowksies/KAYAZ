{
  "cleanUrls": true,
  "redirects": [
    { "source": "/r6-internal", "destination": "/", "permanent": false },
    { "source": "/r6-internal/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "accelerometer=*, autoplay=*, clipboard-write=*, fullscreen=*, gamepad=*, gyroscope=*, magnetometer=*, screen-wake-lock=*, xr-spatial-tracking=*" }
      ]
    }
  ]
}
